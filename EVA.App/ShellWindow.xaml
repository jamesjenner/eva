<Window x:Class="EVA.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="EVA"
        Width="0" Height="0"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="Manual" Topmost="False"
        Visibility="Hidden">
    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="EVA"
                        MenuActivation="RightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="EVA" IsEnabled="False" />
                    <Separator />
                    <MenuItem Header="Create snapshot now" Click="CreateSnapshotNow_Click" />
                    <MenuItem Header="List snapshot content" Click="ListSnapshotContent_Click" />
                    <MenuItem Header="Restore snapshot" Click="RestoreSnapshot_Click" />
                    <Separator />
                    <MenuItem Header="Options" Click="Options_Click" />
                    <Separator />
                    <MenuItem Header="Exit" Click="Exit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
