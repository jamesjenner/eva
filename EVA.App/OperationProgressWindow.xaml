<Window x:Class="EVA.App.OperationProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVA"
        Width="360" Height="140" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="12">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="MessageText" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" Text="Working..." />
            <ProgressBar IsIndeterminate="True" Height="18" />
        </StackPanel>
    </Grid>
</Window>
