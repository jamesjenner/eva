<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="clr-namespace:SukiUI;assembly=SukiUI"
             x:Class="EVA.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <suki:SukiTheme ThemeColor="Blue" />
    </Application.Styles>
    <Application.Resources>
        <SolidColorBrush x:Key="EVAErrorBrush" Color="Crimson" />
        <SolidColorBrush x:Key="EVAWarningBrush" Color="Orange" />
        <SolidColorBrush x:Key="EVASuccessBrush" Color="MediumSeaGreen" />
    </Application.Resources>
</Application>