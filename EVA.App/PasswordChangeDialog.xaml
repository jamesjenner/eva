<Window x:Class="EVA.App.PasswordChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change encryption password"
        Width="420" Height="310" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Current password" Margin="0,0,0,4" />
        <PasswordBox x:Name="CurrentPasswordBox" Grid.Row="1" Margin="0,0,0,10" />

        <TextBlock Grid.Row="2" Text="New password" Margin="0,0,0,4" />
        <PasswordBox x:Name="NewPasswordBox" Grid.Row="3" Margin="0,0,0,10" />

        <TextBlock Grid.Row="4" Text="Confirm new password" Margin="0,0,0,4" />
        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="5" Margin="0,0,0,10" />

        <TextBlock Grid.Row="6" Text="Warning: changing the password starts a new archive chain." Foreground="DarkRed" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10" />
        <CheckBox x:Name="AcknowledgeWarningCheck" Grid.Row="7" Margin="0,0,0,10">I understand and want to continue</CheckBox>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Margin="0,0,8,0" Click="Cancel_Click">Cancel</Button>
            <Button Width="100" Click="Save_Click">Save</Button>
        </StackPanel>
    </Grid>
</Window>
