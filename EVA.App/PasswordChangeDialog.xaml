<Window x:Class="EVA.App.PasswordChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set encryption password"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: Current Password Label -->
            <RowDefinition Height="Auto" /> <!-- 1: Current Password Field -->
            <RowDefinition Height="Auto" /> <!-- 2: New Password Label -->
            <RowDefinition Height="Auto" /> <!-- 3: New Password Field -->
            <RowDefinition Height="Auto" /> <!-- 4: New Password Strength Meter -->
            <RowDefinition Height="Auto" /> <!-- 5: New Password Strength Meter Labels -->
            <RowDefinition Height="Auto" /> <!-- 6: Confirm Password Label -->
            <RowDefinition Height="Auto" /> <!-- 7: Confirm Password Field -->
            <RowDefinition Height="Auto" /> <!-- 8: Warning Alert -->
            <RowDefinition Height="Auto" /> <!-- 9: Checkbox -->
            <RowDefinition Height="Auto" /> <!-- 10: Footer Buttons -->
        </Grid.RowDefinitions>

        <!-- row 0: current password label -->
        <TextBlock Grid.Row="0" x:Name="CurrentPasswordLabel" Text="Current password" Margin="0,0,0,4" />
        
        <!-- row 1: current password field -->
        <Grid Grid.Row="1" x:Name="CurrentPasswordField" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="CurrentPasswordBox" Grid.Column="0" Margin="0,0,8,0"/>
            <TextBox x:Name="CurrentPasswordText" Grid.Column="0" Margin="0,0,8,0" Visibility="Collapsed" />
            <ToggleButton x:Name="CurrentPasswordToggle" Grid.Column="1" Click="CurrentPasswordToggle_Click">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <!-- Default / Unchecked State: Eye Icon -->
                        <Setter Property="Content">
                            <Setter.Value>
                                <Path Data="M12,7c2.76,0,5,2.24,5,5c0,0.65,-0.13,1.26,-0.36,1.82l2.92,2.92c1.51,-1.26,2.7,-2.89,3.44,-4.74c-1.73,-4.39,-6,-7.5,-11,-7.5c-1.4,0,-2.74,0.25,-3.98,0.7l2.16,2.16C10.74,7.13,11.35,7,12,7zM2,4.27l2.28,2.28l0.46,0.46C3.08,8.3,1.78,10.02,1,12c1.73,4.39,6,7.5,11,7.5c1.55,0,3.03,-0.3,4.38,-0.84l0.42,0.42L19.73,22L21,20.73L3.27,3L2,4.27zM7.53,9.8l1.55,1.55c-0.05,0.21,-0.08,0.43,-0.08,0.65c0,1.66,1.34,3,3,3c0.22,0,0.44,-0.03,0.65,-0.08l1.55,1.55c-0.67,0.33,-1.41,0.53,-2.2,0.53c-2.76,0,-5,-2.24,-5,-5c0,-0.79,0.2,-1.53,0.53,-2.2zM11.84,9.02l3.14,3.14c0.01,-0.05,0.02,-0.1,0.02,-0.16c0,-1.66,-1.34,-3,-3,-3c-0.06,0,-0.11,0.01,-0.16,0.02z" 
                                    Fill="#444444" Width="16" Height="16" Stretch="Uniform" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- Checked State: Eye-Off Icon -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content">
                                    <Setter.Value>
                                    <!-- Official Material Design Visibility Off Icon -->
                                        <Path Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"
                                            Fill="#444444"
                                            Stretch="Uniform"
                                            Width="16" Height="16" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </Grid>

        <!-- row 2: New password: label -->
        <TextBlock Grid.Row="2" Text="New password" Margin="0,0,0,4" />

        <!-- row 3: New password: field -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="NewPasswordBox" Grid.Column="0"  Margin="0,0,8,0" PasswordChanged="NewPasswordBox_PasswordChanged"/>
            <TextBox x:Name="NewPasswordText" Grid.Column="0" Margin="0,0,8,0" Visibility="Collapsed" TextChanged="NewPasswordText_TextChanged" />
            <ToggleButton x:Name="NewPasswordToggle" Grid.Column="1" Click="NewPasswordToggle_Click">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <!-- Default / Unchecked State: Eye Icon -->
                        <Setter Property="Content">
                            <Setter.Value>
                                <Path Data="M12,7c2.76,0,5,2.24,5,5c0,0.65,-0.13,1.26,-0.36,1.82l2.92,2.92c1.51,-1.26,2.7,-2.89,3.44,-4.74c-1.73,-4.39,-6,-7.5,-11,-7.5c-1.4,0,-2.74,0.25,-3.98,0.7l2.16,2.16C10.74,7.13,11.35,7,12,7zM2,4.27l2.28,2.28l0.46,0.46C3.08,8.3,1.78,10.02,1,12c1.73,4.39,6,7.5,11,7.5c1.55,0,3.03,-0.3,4.38,-0.84l0.42,0.42L19.73,22L21,20.73L3.27,3L2,4.27zM7.53,9.8l1.55,1.55c-0.05,0.21,-0.08,0.43,-0.08,0.65c0,1.66,1.34,3,3,3c0.22,0,0.44,-0.03,0.65,-0.08l1.55,1.55c-0.67,0.33,-1.41,0.53,-2.2,0.53c-2.76,0,-5,-2.24,-5,-5c0,-0.79,0.2,-1.53,0.53,-2.2zM11.84,9.02l3.14,3.14c0.01,-0.05,0.02,-0.1,0.02,-0.16c0,-1.66,-1.34,-3,-3,-3c-0.06,0,-0.11,0.01,-0.16,0.02z" 
                                    Fill="#444444" Width="16" Height="16" Stretch="Uniform" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- Checked State: Eye-Off Icon -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content">
                                    <Setter.Value>
                                    <!-- Official Material Design Visibility Off Icon -->
                                        <Path Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"
                                            Fill="#444444"
                                            Stretch="Uniform"
                                            Width="16" Height="16" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </Grid>

        <!-- row 4: password strength meter -->
        <ProgressBar Grid.Row="4" Margin="0,6,4,2" x:Name="StrengthMeter" Grid.Column="0" Height="4" Minimum="0" Maximum="100" Value="0" Foreground="Red" Background="#E0E0E0" BorderThickness="0" />

        <!-- row 5: password strength meter labels -->
        <Grid Grid.Row="5" Grid.Column="0" Margin="0,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Weak" FontSize="11" Foreground="DarkRed" FontWeight="SemiBold" HorizontalAlignment="Left" />
            <TextBlock Grid.Column="1" Text="Strong" FontSize="11" Foreground="Green" FontWeight="SemiBold" HorizontalAlignment="Right" />
        </Grid>

        <!-- row 6: Confirm password: label -->
        <TextBlock Grid.Row="6" Text="Confirm new password" Margin="0,0,0,4" />

        <!-- row 7: Confirm password: field -->
        <Grid Grid.Row="7" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="ConfirmPasswordBox" Grid.Column="0"  Margin="0,0,8,0"/>
            <TextBox x:Name="ConfirmPasswordText" Grid.Column="0" Margin="0,0,8,0" Visibility="Collapsed" />
            <ToggleButton x:Name="ConfirmPasswordToggle" Grid.Column="1" Click="ConfirmPasswordToggle_Click">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <!-- Default / Unchecked State: Eye Icon -->
                        <Setter Property="Content">
                            <Setter.Value>
                                <Path Data="M12,7c2.76,0,5,2.24,5,5c0,0.65,-0.13,1.26,-0.36,1.82l2.92,2.92c1.51,-1.26,2.7,-2.89,3.44,-4.74c-1.73,-4.39,-6,-7.5,-11,-7.5c-1.4,0,-2.74,0.25,-3.98,0.7l2.16,2.16C10.74,7.13,11.35,7,12,7zM2,4.27l2.28,2.28l0.46,0.46C3.08,8.3,1.78,10.02,1,12c1.73,4.39,6,7.5,11,7.5c1.55,0,3.03,-0.3,4.38,-0.84l0.42,0.42L19.73,22L21,20.73L3.27,3L2,4.27zM7.53,9.8l1.55,1.55c-0.05,0.21,-0.08,0.43,-0.08,0.65c0,1.66,1.34,3,3,3c0.22,0,0.44,-0.03,0.65,-0.08l1.55,1.55c-0.67,0.33,-1.41,0.53,-2.2,0.53c-2.76,0,-5,-2.24,-5,-5c0,-0.79,0.2,-1.53,0.53,-2.2zM11.84,9.02l3.14,3.14c0.01,-0.05,0.02,-0.1,0.02,-0.16c0,-1.66,-1.34,-3,-3,-3c-0.06,0,-0.11,0.01,-0.16,0.02z" 
                                    Fill="#444444" Width="16" Height="16" Stretch="Uniform" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- Checked State: Eye-Off Icon -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content">
                                    <Setter.Value>
                                    <!-- Official Material Design Visibility Off Icon -->
                                        <Path Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"
                                            Fill="#444444"
                                            Stretch="Uniform"
                                            Width="16" Height="16" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </Grid>

        <!-- row 8: warning text -->
        <TextBlock Grid.Row="8" Text="Warning: this password protects all EVA archives and changing it starts a new archive chain." Foreground="DarkRed" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10" />
        <!-- row 9: warning confirm -->
        <CheckBox Grid.Row="9" x:Name="AcknowledgeWarningCheck" Margin="0,0,0,8">I understand and want to continue</CheckBox>

        <!-- row 10: buttons -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click">Cancel</Button>
            <Button Width="100" Click="Save_Click">Save</Button>
        </StackPanel>
    </Grid>
</Window>
