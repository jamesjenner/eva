<suki:SukiWindow 
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        x:Class="EVA.App.PasswordChangeDialog"
        Title="Set encryption password"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid Margin="12" ColumnDefinitions="*,36" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
        <Border x:Name="ErrorSummaryBorder"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{StaticResource EVAErrorBrush}"
                CornerRadius="4"
                Padding="10,6"
                Opacity="0" >
            <TextBlock x:Name="ErrorSummaryText"
                       Foreground="White"
                       TextWrapping="Wrap"
                       Text="Please correct errors to continue" />
        </Border>

        <TextBlock x:Name="CurrentPasswordLabel" Grid.Row="1" Text="Current password" Margin="0,16,0,0" />
        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="0">
            <TextBox x:Name="CurrentPasswordText" PlaceholderText="Current password" PasswordChar="*" />
            <TextBlock x:Name="CurrentPasswordError"
                       Text="Current password is incorrect"
                       Foreground="{StaticResource EVAErrorBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,2,0,0"
                       Opacity="0" />
        </StackPanel>
        <ToggleButton x:Name="CurrentPasswordToggle" Grid.Row="2" Grid.Column="1" MinWidth="32" Height="32" Padding="6" Click="CurrentPasswordToggle_Click">
            <Grid>
                <PathIcon x:Name="CurrentPasswordHiddenIcon" Data="M630.92-441.08 586-486q9-49.69-28.35-89.35Q520.31-615 466-606l-44.92-44.92q13.54-6.08 27.77-9.12 14.23-3.04 31.15-3.04 68.08 0 115.58 47.5T643.08-500q0 16.92-3.04 31.54-3.04 14.61-9.12 27.38Zm127.23 124.46L714-358q38-29 67.5-63.5T832-500q-50-101-143.5-160.5T480-720q-29 0-57 4t-55 12l-46.61-46.61q37.92-15.08 77.46-22.23Q438.39-780 480-780q140.61 0 253.61 77.54T898.46-500q-22.23 53.61-57.42 100.08-35.2 46.46-82.89 83.3Zm32.31 231.39L628.62-245.85q-30.77 11.39-68.2 18.62Q523-220 480-220q-141 0-253.61-77.54Q113.77-375.08 61.54-500q22.15-53 57.23-98.88 35.08-45.89 77.23-79.58l-110.77-112 42.16-42.15 705.22 705.22-42.15 42.16Zm-552.3-551.08q-31.7 25.23-61.66 60.66Q146.54-540.23 128-500q50 101 143.5 160.5T480-280q27.31 0 54.39-4.62 27.07-4.61 45.92-9.53L529.69-346q-10.23 4.15-23.69 6.61-13.46 2.47-26 2.47-68.08 0-115.58-47.5T316.92-500q0-12.15 2.47-25.42 2.46-13.27 6.61-24.27l-87.84-86.62ZM541-531Zm-131.77 65.77Z" />
                <PathIcon x:Name="CurrentPasswordVisibleIcon" IsVisible="False" Data="M595.58-384.51q47.5-47.59 47.5-115.58t-47.59-115.49q-47.59-47.5-115.58-47.5t-115.49 47.59q-47.5 47.59-47.5 115.58t47.59 115.49q47.59 47.5 115.58 47.5t115.49-47.59ZM403.5-423.5Q372-455 372-500t31.5-76.5Q435-608 480-608t76.5 31.5Q588-545 588-500t-31.5 76.5Q525-392 480-392t-76.5-31.5ZM228.62-296.12Q115.16-372.23 61.54-500q53.62-127.77 167.02-203.88Q341.97-780 479.95-780q137.97 0 251.43 76.12Q844.84-627.77 898.46-500q-53.62 127.77-167.02 203.88Q618.03-220 480.05-220q-137.97 0-251.43-76.12ZM480-500Zm207.5 160.5Q782-399 832-500q-50-101-144.5-160.5T480-720q-113 0-207.5 59.5T128-500q50 101 144.5 160.5T480-280q113 0 207.5-59.5Z" />
            </Grid>
        </ToggleButton>

        <TextBlock Grid.Row="3" Text="New password" Margin="0,16,0,0" />

        <TextBox x:Name="NewPasswordText" Grid.Row="4" Grid.Column="0" PlaceholderText="New password" PasswordChar="*" />
        <ToggleButton x:Name="NewPasswordToggle" Grid.Row="4" Grid.Column="1" MinWidth="32" Height="32" Padding="6" Click="NewPasswordToggle_Click">
            <Grid>
                <PathIcon x:Name="NewPasswordHiddenIcon" Data="M630.92-441.08 586-486q9-49.69-28.35-89.35Q520.31-615 466-606l-44.92-44.92q13.54-6.08 27.77-9.12 14.23-3.04 31.15-3.04 68.08 0 115.58 47.5T643.08-500q0 16.92-3.04 31.54-3.04 14.61-9.12 27.38Zm127.23 124.46L714-358q38-29 67.5-63.5T832-500q-50-101-143.5-160.5T480-720q-29 0-57 4t-55 12l-46.61-46.61q37.92-15.08 77.46-22.23Q438.39-780 480-780q140.61 0 253.61 77.54T898.46-500q-22.23 53.61-57.42 100.08-35.2 46.46-82.89 83.3Zm32.31 231.39L628.62-245.85q-30.77 11.39-68.2 18.62Q523-220 480-220q-141 0-253.61-77.54Q113.77-375.08 61.54-500q22.15-53 57.23-98.88 35.08-45.89 77.23-79.58l-110.77-112 42.16-42.15 705.22 705.22-42.15 42.16Zm-552.3-551.08q-31.7 25.23-61.66 60.66Q146.54-540.23 128-500q50 101 143.5 160.5T480-280q27.31 0 54.39-4.62 27.07-4.61 45.92-9.53L529.69-346q-10.23 4.15-23.69 6.61-13.46 2.47-26 2.47-68.08 0-115.58-47.5T316.92-500q0-12.15 2.47-25.42 2.46-13.27 6.61-24.27l-87.84-86.62ZM541-531Zm-131.77 65.77Z" />
                <PathIcon x:Name="NewPasswordVisibleIcon" IsVisible="False" Data="M595.58-384.51q47.5-47.59 47.5-115.58t-47.59-115.49q-47.59-47.5-115.58-47.5t-115.49 47.59q-47.5 47.59-47.5 115.58t47.59 115.49q47.59 47.5 115.58 47.5t115.49-47.59ZM403.5-423.5Q372-455 372-500t31.5-76.5Q435-608 480-608t76.5 31.5Q588-545 588-500t-31.5 76.5Q525-392 480-392t-76.5-31.5ZM228.62-296.12Q115.16-372.23 61.54-500q53.62-127.77 167.02-203.88Q341.97-780 479.95-780q137.97 0 251.43 76.12Q844.84-627.77 898.46-500q-53.62 127.77-167.02 203.88Q618.03-220 480.05-220q-137.97 0-251.43-76.12ZM480-500Zm207.5 160.5Q782-399 832-500q-50-101-144.5-160.5T480-720q-113 0-207.5 59.5T128-500q50 101 144.5 160.5T480-280q113 0 207.5-59.5Z" />
            </Grid>
        </ToggleButton>

        <ProgressBar x:Name="PasswordStrengthBar" Grid.Row="5" Grid.ColumnSpan="1" Height="4" Minimum="0" Maximum="100" Value="0" HorizontalAlignment="Stretch" />

        <DockPanel Grid.Row="6" LastChildFill="True">
            <TextBlock Text="Weak" HorizontalAlignment="Left" FontSize="11" FontWeight="SemiBold" Foreground="Crimson" />
            <TextBlock Text="Strong" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="MediumSeaGreen" />
        </DockPanel>
        <TextBlock x:Name="NewPasswordError"
                    Grid.Row="7" Grid.Column="0" 
                    Text="Placeholder"
                    Foreground="{StaticResource EVAErrorBrush}"
                    FontSize="12"
                    FontWeight="SemiBold" 
                    Margin="0,2,0,0"
                    Opacity="0" />

        <TextBlock Grid.Row="8" Text="Confirm new password" Margin="0,16,0,0" />

        <TextBox x:Name="ConfirmPasswordText" Grid.Row="9" Grid.Column="0" PlaceholderText="Confirm new password" PasswordChar="*" />
        <ToggleButton x:Name="ConfirmPasswordToggle" Grid.Row="9" Grid.Column="1" MinWidth="32" Height="32" Padding="6" Click="ConfirmPasswordToggle_Click">
            <Grid>
                <PathIcon x:Name="ConfirmPasswordHiddenIcon" Data="M630.92-441.08 586-486q9-49.69-28.35-89.35Q520.31-615 466-606l-44.92-44.92q13.54-6.08 27.77-9.12 14.23-3.04 31.15-3.04 68.08 0 115.58 47.5T643.08-500q0 16.92-3.04 31.54-3.04 14.61-9.12 27.38Zm127.23 124.46L714-358q38-29 67.5-63.5T832-500q-50-101-143.5-160.5T480-720q-29 0-57 4t-55 12l-46.61-46.61q37.92-15.08 77.46-22.23Q438.39-780 480-780q140.61 0 253.61 77.54T898.46-500q-22.23 53.61-57.42 100.08-35.2 46.46-82.89 83.3Zm32.31 231.39L628.62-245.85q-30.77 11.39-68.2 18.62Q523-220 480-220q-141 0-253.61-77.54Q113.77-375.08 61.54-500q22.15-53 57.23-98.88 35.08-45.89 77.23-79.58l-110.77-112 42.16-42.15 705.22 705.22-42.15 42.16Zm-552.3-551.08q-31.7 25.23-61.66 60.66Q146.54-540.23 128-500q50 101 143.5 160.5T480-280q27.31 0 54.39-4.62 27.07-4.61 45.92-9.53L529.69-346q-10.23 4.15-23.69 6.61-13.46 2.47-26 2.47-68.08 0-115.58-47.5T316.92-500q0-12.15 2.47-25.42 2.46-13.27 6.61-24.27l-87.84-86.62ZM541-531Zm-131.77 65.77Z" />
                <PathIcon x:Name="ConfirmPasswordVisibleIcon" IsVisible="False" Data="M595.58-384.51q47.5-47.59 47.5-115.58t-47.59-115.49q-47.59-47.5-115.58-47.5t-115.49 47.59q-47.5 47.59-47.5 115.58t47.59 115.49q47.59 47.5 115.58 47.5t115.49-47.59ZM403.5-423.5Q372-455 372-500t31.5-76.5Q435-608 480-608t76.5 31.5Q588-545 588-500t-31.5 76.5Q525-392 480-392t-76.5-31.5ZM228.62-296.12Q115.16-372.23 61.54-500q53.62-127.77 167.02-203.88Q341.97-780 479.95-780q137.97 0 251.43 76.12Q844.84-627.77 898.46-500q-53.62 127.77-167.02 203.88Q618.03-220 480.05-220q-137.97 0-251.43-76.12ZM480-500Zm207.5 160.5Q782-399 832-500q-50-101-144.5-160.5T480-720q-113 0-207.5 59.5T128-500q50 101 144.5 160.5T480-280q113 0 207.5-59.5Z" />
            </Grid>
        </ToggleButton>
        <TextBlock x:Name="ConfirmPasswordError"
                    Grid.Row="10" Grid.Column="0" 
                    Text="Placeholder"
                    Foreground="{StaticResource EVAErrorBrush}"
                    FontSize="12"
                    FontWeight="SemiBold" 
                    Margin="0,2,0,0"
                    Opacity="0" />

        <TextBlock Grid.Row="12" 
            Grid.ColumnSpan="2" 
            Text="Warning: this password protects all EVA archives and changing it starts a new archive chain."
            Foreground="Orange"
            FontWeight="SemiBold"
            TextWrapping="Wrap" 
            Margin="0,16,0,0" 
            />

        <StackPanel Grid.Row="13" Grid.ColumnSpan="2" Spacing="0">
            <CheckBox x:Name="AcknowledgeWarningCheck" Margin="0,8,0,0">I understand and want to continue</CheckBox>
            <TextBlock x:Name="AcknowledgeError"
                        Text="Please acknowledge to continue"
                        Foreground="{StaticResource EVAErrorBrush}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Margin="0,2,0,0"
                        Opacity="0" />
        </StackPanel>

        <StackPanel Grid.Row="14" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,32,0,0">
            <Button MinWidth="100" Padding="12,6" IsCancel="True" Click="Cancel_Click">Cancel</Button>
            <Button MinWidth="100" Padding="12,6" Click="Save_Click">Save</Button>
        </StackPanel>
    </Grid>
</suki:SukiWindow>
